# /etc/ecosim/ecosim.env -- read by ecosim.service (systemd EnvironmentFile).
# Profile: data source registry, indexed store, caches, saved areas, auth.json.
ECOSIM_CONFIG_DIR=/srv/ecosim/profile
# The in-app folder browser can't leave this directory (model data goes here).
ECOSIM_BROWSE_ROOT=/srv/ecosim/data
# Lock the app if signing in isn't set up (instead of leaving it open).
ECOSIM_REQUIRE_AUTH=1
# Behind nginx: trust X-Forwarded-For / -Proto (sign-in limits per client, Secure cookie).
ECOSIM_TRUST_PROXY=1
# R analyses off until running user scripts safely is designed.
ECOSIM_DISABLE_R=1
